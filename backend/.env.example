# Database
DATABASE_URL=postgresql://vps_user:vps_password@localhost:5432/vps_security

# Server
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development

# Security
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRATION=24h

# Logging
LOG_LEVEL=debug

# Agent Configuration
AGENT_SECRET_KEY=your-agent-secret-key
AGENT_TIMEOUT=30s

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Slack (optional)
SLACK_WEBHOOK_URL=
SLACK_ENABLED=false
