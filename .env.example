# This is a root .env example for the entire project
# Copy to .env and update values as needed

# Database
DATABASE_URL=postgresql://vps_user:vps_password@localhost:5432/vps_security

# Backend Server
BACKEND_PORT=8080
BACKEND_HOST=0.0.0.0

# Frontend
FRONTEND_PORT=3000

# Security
JWT_SECRET=your-super-secret-key-change-this-in-production
AGENT_SECRET_KEY=your-agent-secret-key

# Environment
ENVIRONMENT=development
LOG_LEVEL=debug
